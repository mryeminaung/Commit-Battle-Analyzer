# Copy to .env and fill in. Never commit .env.

# Optional GitHub token — raises API rate limits from 60/hr to 5000/hr.
# Create one at: https://github.com/settings/tokens
# Scope: public_repo is enough (or no scopes for public read-only).
VITE_GITHUB_TOKEN=

# Optional absolute site origin for social/meta tags (og:url, absolute og:image).
# Example: https://your-domain.example
VITE_SITE_URL=
